<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="BookStorePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>vn.edu.hcmute.bookstore.model.User_24110171</class>
        <class>vn.edu.hcmute.bookstore.model.Book_24110171</class>
        <class>vn.edu.hcmute.bookstore.model.Author_24110171</class>
        <class>vn.edu.hcmute.bookstore.model.Rating_24110171</class>
        <class>vn.edu.hcmute.bookstore.model.RatingId_24110171</class>
        <class>vn.edu.hcmute.bookstore.model.CartItem_24110171</class>
        <class>vn.edu.hcmute.bookstore.model.Order_24110171</class>
        <class>vn.edu.hcmute.bookstore.model.OrderItem_24110171</class>
        <properties>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.jdbc.time_zone" value="Asia/Ho_Chi_Minh"/>
        </properties>
    </persistence-unit>
</persistence>
