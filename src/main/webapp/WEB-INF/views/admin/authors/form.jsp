<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><html><head><title>${empty author.authorId?'Thêm':'Sửa'} tác giả</title></head><body><div class="form-card"><h1>${empty author.authorId?'Thêm tác giả':'Cập nhật tác giả'}</h1><form method="post" action="${pageContext.request.contextPath}/admin/authors/save"><input type="hidden" name="id" value="${author.authorId}"><label>Tên tác giả<input name="authorName" required value="${author.authorName}"></label><label>Ngày sinh<input name="dateOfBirth" type="date" value="${author.dateOfBirth}"></label><button>Lưu</button> <a class="button secondary" href="${pageContext.request.contextPath}/admin/authors">Hủy</a></form></div></body></html>
