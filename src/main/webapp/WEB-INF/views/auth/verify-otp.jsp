<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Xác thực OTP</title></head><body><div class="auth-box"><h1>Xác thực OTP</h1><p>Đã tạo OTP cho <b><c:out value="${pending.email}"/></b>.</p><c:if test="${sessionScope.mailSent == false}"><div class="alert">Chế độ demo: SMTP chưa cấu hình. OTP được in trong console Tomcat để kiểm thử.</div></c:if><c:if test="${not empty error}"><div class="alert error"><c:out value="${error}"/></div></c:if><form method="post"><label>Mã OTP<input name="otp" maxlength="6" pattern="[0-9]{6}" required></label><button>Kích hoạt</button></form></div></body></html>
