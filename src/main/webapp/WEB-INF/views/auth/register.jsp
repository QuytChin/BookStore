<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Đăng ký</title></head><body><div class="auth-box"><h1>Đăng ký tài khoản</h1><p>OTP 6 số được gửi qua email và có hiệu lực 5 phút.</p><c:if test="${not empty error}"><div class="alert error"><c:out value="${error}"/></div></c:if><form method="post"><label>Họ tên<input name="fullname" required></label><label>Email<input name="email" type="email" required></label><label>Điện thoại<input name="phone" type="number"></label><label>Mật khẩu<input name="password" type="password" minlength="6" required></label><button>Gửi OTP</button></form></div></body></html>
